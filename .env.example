# API Configuration
VITE_API_URL=https://api.example.com

# Sentry Error Monitoring (Optional - leave empty to disable)
VITE_SENTRY_DSN=

# Analytics
VITE_ENABLE_ANALYTICS=false

# Environment (development | staging | production)
VITE_ENVIRONMENT=development

# Research Database (Supabase) - Optional
# Create a free project at supabase.com, then copy these from Project Settings > API
# If left empty, the "Save to Research DB" button will be hidden
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
